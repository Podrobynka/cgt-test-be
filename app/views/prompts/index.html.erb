<% content_for :title, "Prompts" %>

<div class="w-full">
  <div class="flex justify-between items-center border-b-4 border-b-indigo-300 mb-8">
    <h1 class="font-bold text-4xl">Prompts</h1>
  </div>

  <%= render "search_form" %>

  <div id="prompts" class="min-w-full space-y-5">
    <% if @prompts.any? %>
      <ul class="list-none divide-y divide-indigo-300">
        <% if @query.present? %>
          <% @prompts.with_highlights.each do |prompt, highlights| %>
            <%= render "prompt", prompt: highlights %>
          <% end %>
        <% else %>
          <% @prompts.each do |prompt| %>
            <%= render "prompt", prompt: prompt %>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center my-10">No prompts found.</p>
    <% end %>
  </div>
</div>
